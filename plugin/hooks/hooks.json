{
  "description": "prompt-coach: weak-prompt nudges before send, hint tips after the response, a one-line coaching summary at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pc",
            "args": [
              "nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pc",
            "args": [
              "nudge"
            ],
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pc",
            "args": [
              "nudge"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
